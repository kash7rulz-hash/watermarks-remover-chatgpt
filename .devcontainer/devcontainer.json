{
  "name": "Watermarks Remover API",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PORT": "10000"
  },
  "forwardPorts": [10000, 10001],
  "portsAttributes": {
    "10000": {
      "label": "Watermarks Remover REST API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "10001": {
      "label": "Watermarks Remover MCP",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postStartCommand": "bash .devcontainer/start-service.sh",
  "shutdownAction": "stopContainer"
}
